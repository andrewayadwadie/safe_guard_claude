<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="secure_token_prefs.xml" />
        <exclude domain="sharedpref" path="safeguard_prefs.xml" />
        <exclude domain="database" path="safeguard_database" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow non-sensitive data for device-to-device transfer -->
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="secure_token_prefs.xml" />
        <exclude domain="sharedpref" path="safeguard_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
