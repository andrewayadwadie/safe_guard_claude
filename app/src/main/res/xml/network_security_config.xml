<?xml version="1.0" encoding="utf-8"?>
<!--
    Release network security configuration.

    Cleartext is denied everywhere and only system CAs are trusted.
    Development host exemptions and user-CA trust live in the debug source set at
    app/src/debug/res/xml/network_security_config.xml and never ship.

    Certificate pinning is deliberately NOT configured here. Pinning is enforced in
    exactly one place - the OkHttp client in di/NetworkModule.kt - so there is a
    single source of truth. See the feature spec's Q1 decision.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
