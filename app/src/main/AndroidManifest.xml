<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Usage Stats Permission (Screen Time) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    
    <!-- Accessibility Service Permission (Text Monitoring) -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />
    
    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    
    <!-- Boot Receiver -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    
    <!-- Alarm -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    
    <!-- Wake Lock -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- VPN Permission -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    
    <!-- Read Images (for NSFW detection) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Full Storage Access (for sexting prevention - blur/modify detected images)
         This permission is required for parental control apps to:
         - Replace inappropriate images with blurred versions
         - Protect children from viewing harmful content
         Google Play allows this for parental control category apps -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- System Alert Window (for lock screen overlay) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Phone State (to detect active calls and allow phone calls during bedtime) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Request to ignore battery optimizations (needed to keep accessibility service running) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Full Screen Intent (for lock screen on Android 10+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Query All Packages (required on Android 11+ to see installed apps)
         This is necessary for parental control apps to:
         - Show app list for setting per-app screen time limits
         - Show app list for blocking specific apps
         - Monitor which apps are being used
         Google Play allows this for parental control category apps -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".SafeGuardApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeGuard"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hasFragileUserData="true"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SafeGuard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lock Screen Activity (shown when limits exceeded) -->
        <activity
            android:name=".presentation.lockscreen.LockScreenActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.SafeGuard"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:noHistory="false" />

        <!-- Monitoring Service -->
        <service
            android:name=".service.MonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- Accessibility Service (Text Monitoring) -->
        <service
            android:name=".service.TextMonitoringAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- VPN Service -->
        <service
            android:name=".service.ContentFilterVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN content filtering for parental control" />
        </service>

        <!-- Firebase Messaging Service -->
        <service
            android:name=".service.SafeGuardFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Boot Receiver
             Note: exported=true is required to receive BOOT_COMPLETED broadcast from the system.
             This is safe because BOOT_COMPLETED is a protected broadcast that only the system can send.
             The RECEIVE_BOOT_COMPLETED permission further ensures only our app's receiver gets invoked. -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Tamper Detection Receiver
             Detects when the app data is cleared or app is disabled.
             Note: ACTION_PACKAGE_DATA_CLEARED and ACTION_MY_PACKAGE_REPLACED are
             protected broadcasts that only the system can send. -->
        <receiver
            android:name=".receiver.TamperDetectionReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <!-- Triggered when app data is cleared -->
                <action android:name="android.intent.action.PACKAGE_DATA_CLEARED" />
                <!-- Triggered when app components are changed (enabled/disabled) -->
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <!-- Triggered when our app is updated -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Service Restart Receiver
             Restarts monitoring services when the device wakes up from sleep.
             Critical for Samsung devices with aggressive battery optimization.
             Note: ACTION_USER_PRESENT and ACTION_SCREEN_ON require no special permissions. -->
        <receiver
            android:name=".receiver.ServiceRestartReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.SCREEN_ON" />
            </intent-filter>
        </receiver>

        <!-- WorkManager Initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
